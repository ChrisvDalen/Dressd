# Copy to .env and adjust. docker-compose.yml reads these; .env is gitignored.
#
#   cp .env.example .env

# --- Postgres -----------------------------------------------------------------
POSTGRES_DB=dressd
POSTGRES_USER=dressd
POSTGRES_PASSWORD=dressd

# --- Web ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# --- Authentication -----------------------------------------------------------
# DEV trusts the X-Owner-Id header and is unauthenticated by design — fine for a
# laptop, never for a deployment. TOKEN requires a signed bearer token on every
# API call and is what the `prod` Spring profile defaults to.
AUTH_MODE=DEV

# Required when AUTH_MODE=TOKEN; minimum 32 characters. Services refuse to start
# in TOKEN mode without it, so a misconfigured deployment fails closed.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# Fraction of requests traced in the prod profile (1.0 = all).
TRACING_SAMPLE_RATE=0.1
